# Optional. If the student key is absent, /predict with use_rlm=true falls back to lexical runtime retrieval.
LITELLM_API_KEY=
LITELLM_API_BASE=https://litellm.g-309.ru/v1
RLM_STUDENT_MODEL=openai/gemma-4-e4b

# Teacher model for GEPA reflection.
OPENROUTER_API_KEY=
OPENROUTER_API_BASE=https://openrouter.ai/api/v1
RLM_TEACHER_MODEL=openrouter/anthropic/claude-3.5-sonnet

GEPA_AUTO=light
GEPA_TRAIN_LIMIT=80
