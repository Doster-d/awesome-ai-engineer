# Студенческая модель для рабочего RLM-контура через LiteLLM-совместимый сервер.
LITELLM_API_KEY=
LITELLM_API_BASE=https://litellm.g-309.ru/v1
RLM_STUDENT_MODEL=openai/gemma-4-e4b

# Большая учительская модель для GEPA через OpenRouter.
OPENROUTER_API_KEY=
OPENROUTER_API_BASE=https://openrouter.ai/api/v1
RLM_TEACHER_MODEL=openrouter/anthropic/claude-3.5-sonnet

# Бюджет оптимизации GEPA.
GEPA_AUTO=light
GEPA_TRAIN_LIMIT=80
